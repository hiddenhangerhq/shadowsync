# Which data layer implementation to use: "mock" (local file, no Supabase needed) or "supabase".
DATA_BACKEND=mock

# --- mock backend only ---
# Folder for mock database + uploaded photos (gitignored).
MOCK_DATA_DIR=.data
# Seed a few demo items for a newly created mock account (1 = yes).
MOCK_SEED=1

# --- supabase backend only (DATA_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Not used by step 1 code paths, reserved for webhooks/cron.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for item photos (created by migration 0003).
SUPABASE_PHOTO_BUCKET=item-photos
